{
    "name": "remarkable-synchronizer",
    "version": "2.5.0",
    "description": "Connect to the reMarkable cloud, list, download, and sync notebook pages as images.",
    "author": {
        "name": "Sébastien Dubois",
        "email": "seb@dsebastien.net",
        "url": "https://dsebastien.net"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin",
        "remarkable",
        "sync",
        "notebooks"
    ],
    "license": "MIT",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dsebastien/obsidian-remarkable-sync.git"
    },
    "bugs": {
        "url": "https://github.com/dsebastien/obsidian-remarkable-sync/issues"
    },
    "homepage": "https://github.com/dsebastien/obsidian-remarkable-sync",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.1.0"
    },
    "main": "main.js",
    "packageManager": "bun@1.4.0",
    "config": {
        "commitizen": {
            "path": "node_modules/cz-customizable"
        },
        "cz-customizable": {
            "config": ".cz-config.cjs"
        }
    },
    "scripts": {
        "dev": "bun scripts/build.ts",
        "build": "bun run tsc && bun scripts/build.ts --prod",
        "setup": "git config --local --replace-all include.path ../.gitconfig",
        "tsc": "tsc --noEmit",
        "tsc:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "tscw": "bun run tsc:watch",
        "lint": "node scripts/require-node.mjs && eslint . --max-warnings 0",
        "lint:fix": "node scripts/require-node.mjs && eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test --isolate",
        "test:watch": "bun test --isolate --watch",
        "commit": "cz",
        "cm": "cz",
        "commit:lint": "commitlint --edit",
        "release:update-version": "bun scripts/update-version.ts",
        "release:version-bump": "bun scripts/version-bump.ts",
        "release:changelog": "bun scripts/generate-changelog.ts",
        "release": "./scripts/release.sh",
        "validate": "bun run --parallel tsc test lint rules:check",
        "rules:check": "bun scripts/rules-baseline.ts",
        "rules:baseline": "bun scripts/rules-baseline.ts --write"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.3",
        "@commitlint/config-conventional": "20.5.3",
        "@eslint/js": "9.39.5",
        "@tailwindcss/cli": "4.3.3",
        "@types/bun": "1.4.3",
        "@types/node": "26.6.5",
        "commitizen": "4.3.2",
        "conventional-changelog-cli": "5.0.0",
        "conventional-changelog-conventionalcommits": "9.1.0",
        "cz-customizable": "7.5.4",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-obsidianmd": "0.4.2",
        "globals": "17.13.0",
        "jiti": "2.7.0",
        "obsidian": "1.14.4",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2"
    },
    "dependencies": {
        "@cantoo/pdf-lib": "2.11.1",
        "@leeoniya/ufuzzy": "1.0.19",
        "date-fns": "4.4.0",
        "fflate": "0.8.3",
        "immer": "11.1.21",
        "zod": "4.6.7"
    },
    "overrides": {
        "tmp": "0.2.7",
        "lodash": "4.18.1",
        "@conventional-changelog/git-client": "2.7.0"
    }
}
